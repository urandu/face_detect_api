# Production Environment Variables Template
# Copy this file to .env and configure for your production environment

# =============================================================================
# REQUIRED VARIABLES - Must be set for production
# =============================================================================

# Django Secret Key - Generate a new secure key for production
# You can generate one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-super-secret-django-key-here

# Database Configuration
DATABASE_NAME=django_prod
DATABASE_USER=django_user
DATABASE_PASSWORD=your-secure-database-password
DATABASE_HOST=database
DATABASE_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your-secure-rabbitmq-password
RABBITMQ_VHOST=/

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-secure-minio-password

# =============================================================================
# OPTIONAL VARIABLES - Have sensible defaults
# =============================================================================

# Application Ports
API_PORT=80
API_SSL_PORT=443

# MinIO Settings
MINIO_USE_HTTPS=false

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# 1. Never commit this file with real credentials to version control
# 2. Use strong, unique passwords for all services
# 3. Consider using Docker secrets or external secret management in production
# 4. Enable HTTPS in production by updating Nginx configuration
# 5. Update ALLOWED_HOSTS in settings_prod.py for your domain
# 
# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# 
# Before deploying to production:
# 
# □ Set all required environment variables above
# □ Update ALLOWED_HOSTS in face_detect_api/settings_prod.py
# □ Configure SSL certificates (see nginx/conf.d/default.conf)
# □ Review security headers in nginx/nginx.conf
# □ Set up proper backup strategy for volumes
# □ Configure log aggregation and monitoring
# □ Test the application thoroughly
# 
# =============================================================================
